{
  "name": "unconfusables",
  "version": "0.1.1",
  "description": "Unicode confusable detection, spoof checking, identifier profiling, and script analysis based on UTS #39 and UAX #31",
  "keywords": [
    "confusables",
    "homograph",
    "identifier",
    "phishing",
    "script-analysis",
    "security",
    "spoofing",
    "typescript",
    "uax31",
    "unicode",
    "uts39"
  ],
  "homepage": "https://github.com/bysages/typography#readme",
  "bugs": {
    "url": "https://github.com/bysages/typography/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/typography.git",
    "directory": "packages/unconfusables"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "import": "./dist/script.mjs",
      "default": "./dist/script.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish",
    "update:data": "node scripts/update.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
