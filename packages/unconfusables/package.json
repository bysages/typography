{
  "name": "unconfusables",
  "version": "0.1.0",
  "description": "Unicode confusable characters detection and string normalization library based on UTS #39",
  "keywords": [
    "attack",
    "confusables",
    "detection",
    "homograph",
    "normalization",
    "phishing",
    "prevention",
    "safety",
    "security",
    "string",
    "typescript",
    "typography",
    "unicode",
    "uts39"
  ],
  "homepage": "https://github.com/bysages/typography#readme",
  "bugs": {
    "url": "https://github.com/bysages/typography/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/typography.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "import": "./dist/script.mjs",
      "default": "./dist/script.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish",
    "update:data": "node scripts/update.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
