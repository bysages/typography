{
  "name": "unocr",
  "version": "0.1.1",
  "description": "Unified OCR across native, CLI, browser, Tesseract, and AI vision engines with structured HTML or hast output",
  "keywords": [
    "ai-vision",
    "hast",
    "html",
    "ocr",
    "shape-detection",
    "tesseract",
    "text-recognition",
    "typescript",
    "visionkit",
    "windows-media-ocr"
  ],
  "homepage": "https://github.com/bysages/typography#readme",
  "bugs": {
    "url": "https://github.com/bysages/typography/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/typography.git",
    "directory": "packages/unocr"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./drivers/auto": {
      "types": "./dist/drivers/auto.d.mts",
      "browser": "./dist/drivers/auto.browser.mjs",
      "import": "./dist/drivers/auto.mjs",
      "default": "./dist/drivers/auto.mjs"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.mts",
      "import": "./dist/drivers/*.mjs",
      "default": "./dist/drivers/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "hast-util-from-html": "2.0.3",
    "undio": "0.2.0"
  },
  "devDependencies": {
    "@napi-rs/system-ocr": "^1.2.0",
    "ai": "^7.0.137",
    "tesseract.js": "^7.0.0"
  },
  "peerDependencies": {
    "@napi-rs/system-ocr": "^1.2.0",
    "ai": "^7.0.137",
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    },
    "@napi-rs/system-ocr": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
