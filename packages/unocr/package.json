{
  "name": "unocr",
  "version": "0.1.0",
  "description": "Unified OCR library with native, CLI, WASM, browser, and AI drivers, producing a shared structured document with lines, words, and normalized boxes",
  "keywords": [
    "ai",
    "artificial-intelligence",
    "bounding-box",
    "computer-vision",
    "document-analysis",
    "gpt",
    "hast",
    "hocr",
    "image-processing",
    "multi-language",
    "multimodal",
    "nodejs",
    "ocr",
    "ocr-document",
    "ocr-engine",
    "openai",
    "optical-character-recognition",
    "structured-data",
    "system-ocr",
    "tesseract",
    "text-extraction",
    "text-recognition",
    "textdetector",
    "typescript",
    "vercel-ai",
    "vision",
    "visionkit",
    "windows-media-ocr"
  ],
  "homepage": "https://github.com/bysages/typography#readme",
  "bugs": {
    "url": "https://github.com/bysages/typography/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/typography.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.mts",
      "import": "./dist/drivers/*.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "hast-util-from-html": "2.0.3",
    "undio": "0.2.0"
  },
  "devDependencies": {
    "@napi-rs/system-ocr": "^1.2.0",
    "ai": "^7.0.137",
    "tesseract.js": "^7.0.0"
  },
  "peerDependencies": {
    "@napi-rs/system-ocr": "^1.2.0",
    "ai": "^7.0.137",
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    },
    "@napi-rs/system-ocr": {
      "optional": true
    }
  }
}
